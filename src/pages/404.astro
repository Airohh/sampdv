---
// Page servie par Cloudflare quand une URL n'existe pas (wrangler.jsonc : not_found_handling = "404-page").
// Le site lui-même est une seule page statique : public/index.html.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Page not found · Sam Pondevie</title>
		<style is:global>
			:root { color-scheme: dark; }
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 24px 16px;
				background: #03050a;
				color: #f4f5f8;
				font-family: 'Helvetica Neue', Arial, sans-serif;
				text-align: center;
			}
			p { margin: 0 0 16px; color: rgba(244, 245, 248, 0.68); }
			h1 { margin: 0 0 12px; font-family: 'Iowan Old Style', 'Times New Roman', serif; font-weight: 400; font-size: 3rem; }
			a { color: #f3d6c1; }
		</style>
	</head>
	<body>
		<main>
			<p>404</p>
			<h1>This page doesn't exist.</h1>
			<a href="/">Back to sampdv.com</a>
		</main>
	</body>
</html>
